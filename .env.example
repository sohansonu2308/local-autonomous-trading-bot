# ============================================================================
# WHALE-MINDSET AUTONOMOUS CRYPTO TRADING BOT - CONFIGURATION
# ============================================================================
# Paste your LLM API key below (or update it directly from the Dashboard UI).
# Supported providers: gemini | openai | anthropic | openrouter | groq
LLM_PROVIDER=gemini
LLM_API_KEY=YOUR_LLM_API_KEY_HERE
LLM_MODEL=gemini-2.5-flash

# Initial Paper Trading Account Setup
INITIAL_BALANCE_USD=10000.0
MAX_RISK_PER_TRADE_PCT=1.5
MAX_OPEN_POSITIONS=3
TAKER_FEE_PCT=0.055
SLIPPAGE_PCT=0.02

# Default Watchlist (Coin-Agnostic: Add/remove any USDT perpetual symbol)
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,SUIUSDT

# Autonomous Scan Interval (seconds)
SCAN_INTERVAL_SECONDS=300
